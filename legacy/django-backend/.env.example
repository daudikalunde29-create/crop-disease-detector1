# Copy to backend/.env and fill in. Never commit backend/.env.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origins of the frontend dev server that proxies /api to Django (Vite default for this project: 8080)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# --- M4.2: Google Sign-In ------------------------------------------------------
# OAuth 2.0 *Web* Client ID from Google Cloud Console (looks like 123-abc.apps.googleusercontent.com).
# Public value, no client secret needed. Leave empty to disable Google sign-in (the button shows
# "needs backend setup" and POST /api/auth/google/ answers 503 GOOGLE_NOT_CONFIGURED).
# Add your frontend origin (e.g. http://localhost:8080) under "Authorized JavaScript origins" in Google Cloud Console.
GOOGLE_CLIENT_ID=

# --- M4.2: Password reset email -------------------------------------------------
# Public origin of the frontend; used to build the link inside the reset email.
FRONTEND_ORIGIN=http://localhost:8080
# Reset-link lifetime in seconds (default 3600 = 1 hour).
PASSWORD_RESET_TIMEOUT=3600
# Development: leave EMAIL_BACKEND empty -> emails are PRINTED in the runserver terminal (not delivered).
# Production: use SMTP and fill in the EMAIL_* values, e.g.
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=
DEFAULT_FROM_EMAIL=

# --- M4.2: /api/predict/ upload limits -------------------------------------------
# Keep PREDICT_MAX_UPLOAD_BYTES in sync with MAX_FILE_SIZE in public/site/js/scan.js. Defaults: 5 MB, 40 megapixels.
# PREDICT_MAX_UPLOAD_BYTES=5242880
# PREDICT_MAX_IMAGE_PIXELS=40000000
